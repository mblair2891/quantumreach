}

model MailboxProvisioningEvent {
  id                 String   @id @default(cuid())
  workspaceId         String
  managedMailboxId    String?
  idempotencyKey      String   @unique
  status             String   @default("PENDING")
  safeSummary         String?
  errorCode           String?
  safeErrorMessage    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([workspaceId, status])
}

model InfrastructureSenderIdentity {
  id                  String   @id @default(cuid())
  workspaceId          String
  managedMailboxId     String?
  managedDomainId      String
  fromAddress          String
  displayName          String?
  replyToAddress       String?
  sesIdentityState     String   @default("NOT_CREATED")
  dkimState            String   @default("NOT_CREATED")
  sendingEnabled       Boolean  @default(false)
  campaignEligible     Boolean  @default(false)
  dailySendCap         Int?
  healthState          String   @default("UNKNOWN")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([workspaceId, fromAddress])
  @@index([workspaceId, campaignEligible])
}

model DesiredDnsRecord {
  id              String   @id @default(cuid())
  workspaceId      String?
  managedDomainId  String
  recordType       String
  name             String
  value            String
  ttl              Int?
  purpose          String
  status           String   @default("REQUIRED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([managedDomainId, recordType, name, value])
}

model DnsReconciliationRun {
  id               String   @id @default(cuid())
  workspaceId       String?
  managedDomainId   String
  provider          String
  status            String   @default("PENDING")
  missingRecords    Json     @default("[]")
  mismatchedRecords Json     @default("[]")
  appliedRecords    Json     @default("[]")
  safeSummary       String?
  createdAt         DateTime @default(now())
  completedAt       DateTime?
}

model InboundEmailMessage {
  id                    String   @id @default(cuid())
  workspaceId            String
  managedMailboxId       String
  externalMessageId      String
  internetMessageId      String?
  inReplyTo              String?
  references             String?
  sender                 String
  recipients             Json
  subject                String?
  receivedAt             DateTime
  bodyText               String?
  safeHtml               String?
  processingStatus       String   @default("PENDING")
  linkedContactId        String?
  linkedCampaignId       String?
  linkedOutboundMessageId String?
  threadKey              String?
  createdAt              DateTime @default(now())

  @@unique([workspaceId, managedMailboxId, externalMessageId])
  @@index([workspaceId, threadKey])
}

model OutboundMessageLedger {
  id                 String   @id @default(cuid())
  workspaceId         String
  campaignId          String?
  contactId           String?
  senderIdentityId    String?
  managedMailboxId    String?
  managedDomainId     String?
  provider            String
  providerMessageId   String?
  messageId           String?  @unique
  status              String   @default("QUEUED")
  queuedAt            DateTime @default(now())
  sentAt              DateTime?
  deliveredAt         DateTime?
  bouncedAt           DateTime?
  complainedAt        DateTime?
  repliedAt           DateTime?
  unsubscribedAt      DateTime?
  failureCode         String?
  safeFailureMessage  String?

  @@index([workspaceId, status])
  @@index([providerMessageId])
}

model CampaignSendJob {
  id          String   @id @default(cuid())
  workspaceId String
  campaignId  String?
  status      String   @default("QUEUED")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkspaceInfrastructureUsage {
  id                          String   @id @default(cuid())
  workspaceId                  String
  periodStart                  DateTime
  periodEnd                    DateTime
  sentMessageCount             Int      @default(0)
  managedDomainCount           Int      @default(0)
  activeMailboxCount           Int      @default(0)
  senderIdentityCount          Int      @default(0)
  activeOutreachContactCount   Int      @default(0)
  campaignSendCount            Int      @default(0)
  providerErrorCount           Int      @default(0)
  updatedAt                    DateTime @updatedAt

  @@unique([workspaceId, periodStart, periodEnd])
}

model InfrastructureJob {
  id             String   @id @default(cuid())
  workspaceId    String?
  jobType        String
  status         String   @default("QUEUED")
  payload        Json     @default("{}")
  idempotencyKey String   @unique
  lockedAt       DateTime?
  lockedBy       String?
  attemptCount   Int      @default(0)
  maxAttempts    Int      @default(5)
  nextAttemptAt  DateTime @default(now())
  lastSafeError  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([workspaceId, jobType])
}

model CommissionRule {
  id                String                  @id @default(cuid())
  productCategory   CommerceProductCategory
  commissionType    AffiliateCommissionType
  rateBasisPoints   Int?
  fixedAmountMinor  Int?
  recurringEligible Boolean                 @default(true)
  active            Boolean                 @default(true)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  metadata          Json                    @default("{}")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([productCategory, active])
}

model WorkspaceInfrastructureProvisioning {
  id             String                         @id @default(cuid())
  workspaceId    String
  status         InfrastructureProvisioningStatus @default(PENDING)
  idempotencyKey String                         @unique
  stages         Json                           @default("{}")
  requestedPlan  Json                           @default("{}")
  safeSummary    String?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  @@index([workspaceId, status])
}
