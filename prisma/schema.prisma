generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum WorkspaceRoleKey {
  PLATFORM_OWNER
  WORKSPACE_OWNER
  ADMIN
  MANAGER
  STRATEGIST
  SALES_REP
  SALES
  CONSULTANT
  OPERATIONS
  DELIVERY
  VIEWER
  CLIENT
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
  ARCHIVED
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DiagnosticStatus {
  DRAFT
  IN_PROGRESS
  TRANSCRIPT_READY
  ANALYZING
  ANALYZED
  REVIEWED
  ARCHIVED
}

enum AIExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum ReviewStatus {
  DRAFT
  NEEDS_REVIEW
  REVIEWED
  FINAL
  REJECTED
}

enum ReportStatus {
  DRAFT
  GENERATED
  REVIEWED
  FINAL
  ARCHIVED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  AT_RISK
  COMPLETED
  ARCHIVED
}

enum HandoffStatus {
  DRAFT
  READY
  ACCEPTED
  IN_DELIVERY
  COMPLETED
  ARCHIVED
}

enum KnowledgeAuthorityLevel {
  SYSTEM_DOCTRINE
  PRODUCT_DOCTRINE
  UX_COPY_DOCTRINE
  STRATEGY_FRAMEWORK
  DIAGNOSTIC_FRAMEWORK
  ROI_FRAMEWORK
  REPORT_FRAMEWORK
  ROADMAP_FRAMEWORK
  PROPOSAL_FRAMEWORK
  EXECUTION_HANDOFF
  AUTHORITY_TEMPLATE
  TRAINING_CURRICULUM
  COURSE_TEMPLATE
  REFERENCE
}

enum KnowledgePriority {
  GLOBAL
  HIGH
  MEDIUM
  LOW
}

enum KnowledgeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkflowStage {
  LEAD_CAPTURE
  OUTREACH
  DISCOVERY_CALL
  TRANSCRIPT_ANALYSIS
  DIAGNOSTIC_REVIEW
  REPORT_GENERATION
  ROADMAP_GENERATION
  PROPOSAL_GENERATION
  ROI_MODELING
  IMPLEMENTATION_HANDOFF
  AUTHORITY_ASSET_GENERATION
  ACADEMY_TRAINING
  APP_UX
  OFFER_CREATION
  POSITIONING
}

enum LeadImportMethod {
  MANUAL
  CSV
  CRM_IMPORT
  APPROVED_DATA_PROVIDER
  OTHER
}

enum OutreachPermissionStatus {
  UNKNOWN
  PERMITTED
  DO_NOT_CONTACT
  NEEDS_REVIEW
}

enum OutreachStatus {
  NOT_STARTED
  QUEUED
  SENT
  OPENED
  REPLIED
  CALL_BOOKED
  CALL_COMPLETED
  TRANSCRIPT_READY
  ANALYZED
}

enum CallProvider {
  ZOOM
  GOOGLE_MEET
  TEAMS
  OTHER
}

enum CallSessionStatus {
  SCHEDULED
  COMPLETED
  TRANSCRIPT_READY
  DIAGNOSTIC_CREATED
  ANALYZED
  ARCHIVED
}

enum MeetingProvider {
  ZOOM
  GOOGLE_MEET
  MICROSOFT_TEAMS
  NATIVE_LIVEKIT
  EXTERNAL_LINK
}

enum IntegrationProvider {
  ZOOM
  GOOGLE
  MICROSOFT
}

enum IntegrationStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum ProviderWebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum MeetingProviderArtifactStatus {
  DISCOVERED
  IMPORTING
  IMPORTED
  FAILED
  SKIPPED
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELED
}

enum MeetingParticipantRole {
  HOST
  CO_HOST
  PARTICIPANT
  GUEST
}

enum MeetingEventType {
  LOBBY_JOIN_REQUESTED
  PARTICIPANT_ADMITTED
  PARTICIPANT_DENIED
  PARTICIPANT_LEFT_LOBBY
  RECORDING_CONSENT_PREPARED
  TOKEN_ISSUED
  PARTICIPANT_JOINED
  PARTICIPANT_LEFT
  SCREEN_SHARE_STARTED
  SCREEN_SHARE_STOPPED
  ROOM_OPENED
  ROOM_ENDED
}

enum MeetingRecordingPreference {
  NONE
  ZOOM_CLOUD
  LOCAL_UPLOAD
}

enum MeetingRecordingSource {
  ZOOM_CLOUD
  LOCAL_UPLOAD
  LEGACY_NATIVE
}

enum MeetingRecordingImportStatus {
  NOT_REQUESTED
  PENDING
  UPLOADING
  IMPORTING
  AVAILABLE
  FAILED
  CANCELLED
}

enum MeetingRecordingStatus {
  CONSENT_REQUIRED
  READY
  STARTING
  RECORDING
  PAUSING
  PAUSED
  RESUMING
  STOPPING
  PROCESSING
  AVAILABLE
  FAILED
  CANCELLED
  DELETED
}

enum RecordingConsentStatus {
  PENDING
  CONSENTED
  DECLINED
  REVOKED
  NOT_REQUIRED
}

enum MeetingTranscriptionStatus {
  NOT_REQUESTED
  QUEUED
  PROCESSING
  REVIEW_REQUIRED
  APPROVED
  FAILED
}

enum MeetingTranscriptionJobStatus {
  QUEUED
  PROCESSING
  RETRY_WAIT
  COMPLETED
  FAILED
  CANCELLED
}

enum MeetingLobbyStatus {
  WAITING
  ADMITTED
  DENIED
  CANCELLED
  EXPIRED
}

enum MeetingRecordingEventType {
  RECORDING_CONSENT_PREPARED
  CONSENT_REQUESTED
  CONSENT_GRANTED
  CONSENT_DECLINED
  CONSENT_REVOKED
  RECORDING_START_REQUESTED
  RECORDING_STARTED
  RECORDING_PAUSE_REQUESTED
  RECORDING_PAUSED
  RECORDING_RESUME_REQUESTED
  RECORDING_RESUMED
  RECORDING_SEGMENT_STARTED
  RECORDING_SEGMENT_FINALIZED
  RECORDING_SEGMENT_FAILED
  RECORDING_STOP_REQUESTED
  RECORDING_STOPPED
  RECORDING_PROCESSING
  RECORDING_AVAILABLE
  RECORDING_FAILED
  TRANSCRIPTION_QUEUED
  TRANSCRIPTION_STARTED
  TRANSCRIPTION_COMPLETED
  TRANSCRIPTION_FAILED
  TRANSCRIPT_EDITED
  TRANSCRIPT_APPROVED
  CALL_SESSION_UPDATED
  RECORDING_DOWNLOADED
  RECORDING_DELETED
}

enum MeetingRecordingSegmentStatus {
  STARTING
  RECORDING
  STOPPING
  PROCESSING
  AVAILABLE
  FAILED
  CANCELLED
}

model UserProfile {
  id           String            @id @default(cuid())
  clerkUserId  String            @unique
  email        String            @unique
  firstName    String?
  lastName     String?
  imageUrl     String?
  platformRole WorkspaceRoleKey?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  auditLogs                    AuditLog[]
  hostedMeetings               MeetingRoom[]                 @relation("MeetingHost")
  connectedMeetingIntegrations WorkspaceMeetingIntegration[]
  meetingParticipants          MeetingParticipant[]          @relation("MeetingParticipantUser")
  requestedRecordings          MeetingRecording[]            @relation("RecordingRequestedBy")
  startedRecordings            MeetingRecording[]            @relation("RecordingStartedBy")
  stoppedRecordings            MeetingRecording[]            @relation("RecordingStoppedBy")
  uploadedRecordings           MeetingRecording[]            @relation("RecordingUploadedBy")
  approvedRecordings           MeetingRecording[]            @relation("TranscriptApprovedBy")
  recordingConsents            MeetingRecordingConsent[]
  lobbyAdmissions              MeetingLobbyEntry[]
  memberships                  WorkspaceMember[]
  ownedWorkspaces              Workspace[]                   @relation("WorkspaceOwner")
  assignedManagedDomains       ManagedDomain[]               @relation("ManagedDomainAssignedBy")
  managedDomainAssignments     ManagedDomainAssignment[]     @relation("ManagedDomainAssignmentAssignedBy")
  requestedDomainPurchases     DomainPurchaseRequest[]       @relation("DomainPurchaseRequestedBy")
  approvedDomainPurchases      DomainPurchaseRequest[]       @relation("DomainPurchaseApprovedBy")
  confirmedRegistrantProfiles  DomainRegistrantProfile[]     @relation("DomainRegistrantProfileConfirmedBy")
  domainWarmupEvents           DomainWarmupEvent[]           @relation("DomainWarmupEventCreatedBy")
  domainAuditEvents            DomainAuditEvent[]            @relation("DomainAuditActor")
}

model Workspace {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  settings    Json         @default("{}")
  ownerId     String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  owner                     UserProfile?                         @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities                Activity[]
  aiExecutions              AIExecution[]
  analyses                  AnalysisRecord[]
  auditLogs                 AuditLog[]
  lobbyEntries              MeetingLobbyEntry[]
  clients                   Client[]
  companies                 Company[]
  contacts                  Contact[]
  diagnostics               DiagnosticSession[]
  documentAssets            DocumentAsset[]
  followUps                 FollowUp[]
  frameworks                Framework[]
  handoffRecords            HandoffRecord[]
  knowledgeRecords          KnowledgeRecord[]
  knowledgeDocuments        KnowledgeDocument[]
  knowledgeChunks           KnowledgeChunk[]
  knowledgeCollections      KnowledgeCollection[]
  knowledgeDocumentUsages   KnowledgeDocumentUsage[]
  knowledgeSourceReferences KnowledgeSourceReference[]
  leads                     Lead[]
  members                   WorkspaceMember[]
  notes                     Note[]
  opportunities             Opportunity[]
  permissions               Permission[]
  pipelines                 Pipeline[]
  pipelineStages            PipelineStage[]
  playbooks                 Playbook[]
  promptTemplates           PromptTemplate[]
  projects                  ImplementationProject[]              @relation("WorkspaceProjects")
  proposals                 Proposal[]
  reminders                 Reminder[]
  reports                   ExecutiveReport[]
  roles                     Role[]
  roadmaps                  StrategicRoadmap[]
  tags                      Tag[]
  tasks                     Task[]
  templates                 Template[]
  communicationLogs         CommunicationLog[]
  segments                  Segment[]
  outreachCampaigns         OutreachCampaign[]
  outreachSteps             OutreachStep[]
  leadOutreachStatuses      LeadOutreachStatus[]
  callSessions              CallSession[]
  meetingRooms              MeetingRoom[]
  meetingParticipants       MeetingParticipant[]
  meetingInvitations        MeetingInvitation[]
  meetingEvents             MeetingEvent[]
  meetingRecordings         MeetingRecording[]
  meetingRecordingSegments  MeetingRecordingSegment[]
  meetingRecordingConsents  MeetingRecordingConsent[]
  meetingRecordingEvents    MeetingRecordingEvent[]
  meetingTranscriptionJobs  MeetingTranscriptionJob[]
  meetingIntegrations       WorkspaceMeetingIntegration[]
  providerWebhookEvents     ProviderWebhookEvent[]
  meetingProviderArtifacts  MeetingProviderArtifact[]
  contactImportBatches      ContactImportBatch[]
  contactImportRows         ContactImportRow[]
  suppressionListEntries    SuppressionListEntry[]
  sendingDomains            SendingDomain[]
  managedDomains            ManagedDomain[]
  managedDomainAssignments  ManagedDomainAssignment[]
  domainPurchaseRequests    DomainPurchaseRequest[]
  domainRegistrantProfiles  DomainRegistrantProfile[]
  domainAuditEvents         DomainAuditEvent[]
  senderIdentities          SenderIdentity[]
  emailCampaigns            EmailCampaign[]
  emailSequenceSteps        EmailSequenceStep[]
  emailRecipients           EmailRecipient[]
  emailSends                EmailSend[]
  emailEvents               EmailEvent[]
  schedulingPages           SchedulingPage[]
  bookings                  Booking[]
  bookingQuestions          BookingQuestion[]
  bookingResponses          BookingResponse[]
  researchRuns              ResearchRun[]
  interviewQuestionSets     InterviewQuestionSet[]
  contractTemplates         ContractTemplate[]
  contractSigners           ContractSigner[]
  contractSignatures        ContractSignature[]
  contractAuditEvents       ContractAuditEvent[]
  contractDocumentArtifacts ContractDocumentArtifact[]
  workspaceSubscription     WorkspaceSubscription?
  provisioningRequests      ClientWorkspaceProvisioningRequest[]

  @@index([slug])
  @@index([ownerId])
}

model WorkspaceMember {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  roleKey     WorkspaceRoleKey @default(VIEWER)
  title       String?
  status      RecordStatus     @default(ACTIVE)
  invitedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, roleKey])
  @@index([userId])
}

model Role {
  id          String           @id @default(cuid())
  workspaceId String
  key         WorkspaceRoleKey
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions Permission[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model Permission {
  id          String   @id @default(cuid())
  workspaceId String
  roleId      String?
  action      String
  subject     String
  createdAt   DateTime @default(now())

  role      Role?     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, subject])
  @@index([roleId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  actor     UserProfile? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType, entityId])
  @@index([actorId])
}

model Pipeline {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  description String?
  isDefault   Boolean      @default(false)
  status      RecordStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  stages        PipelineStage[]

  @@index([workspaceId, status])
}

model PipelineStage {
  id          String       @id @default(cuid())
  workspaceId String
  pipelineId  String
  name        String
  position    Int
  probability Int          @default(0)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([workspaceId, pipelineId, position])
}

model Company {
  id            String       @id @default(cuid())
  workspaceId   String
  name          String
  domain        String?
  industry      String?
  employeeCount Int?
  annualRevenue Decimal?     @db.Decimal(18, 2)
  status        RecordStatus @default(ACTIVE)
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clients       Client[]
  contacts      Contact[]
  opportunities Opportunity[]
  callSessions  CallSession[]
  meetingRooms  MeetingRoom[]

  @@index([workspaceId, name])
  @@index([workspaceId, status])
}

model Contact {
  id          String       @id @default(cuid())
  workspaceId String
  companyId   String?
  firstName   String
  lastName    String
  email       String?
  phone       String?
  title       String?
  status      RecordStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  callSessions  CallSession[]
  meetingRooms  MeetingRoom[]

  @@index([workspaceId, email])
  @@index([workspaceId, companyId])
}

model Lead {
  id                       String                   @id @default(cuid())
  workspaceId              String
  companyId                String?
  contactId                String?
  source                   String?
  sourcePlatform           String?
  sourceUrl                String?
  importMethod             LeadImportMethod         @default(MANUAL)
  campaignName             String?
  sourceNotes              String?
  outreachPermissionStatus OutreachPermissionStatus @default(UNKNOWN)
  name                     String
  email                    String?
  status                   LeadStatus               @default(NEW)
  score                    Int?
  createdById              String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outreachStatuses LeadOutreachStatus[]
  callSessions     CallSession[]
  meetingRooms     MeetingRoom[]

  @@index([workspaceId, status])
  @@index([workspaceId, email])
}

model Client {
  id          String       @id @default(cuid())
  workspaceId String
  companyId   String?
  name        String
  status      RecordStatus @default(ACTIVE)
  healthScore Int?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

model Opportunity {
  id          String            @id @default(cuid())
  workspaceId String
  pipelineId  String?
  stageId     String?
  companyId   String?
  contactId   String?
  leadId      String?
  name        String
  amount      Decimal?          @db.Decimal(18, 2)
  closeDate   DateTime?
  status      OpportunityStatus @default(OPEN)
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company      Company?                @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?                @relation(fields: [contactId], references: [id], onDelete: SetNull)
  pipeline     Pipeline?               @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stage        PipelineStage?          @relation(fields: [stageId], references: [id], onDelete: SetNull)
  workspace    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  estimates    Estimate[]
  projects     ImplementationProject[]
  proposals    Proposal[]
  callSessions CallSession[]
  meetingRooms MeetingRoom[]

  @@index([workspaceId, status])
  @@index([workspaceId, stageId])
  @@index([companyId])
  @@index([contactId])
  @@index([leadId])
}

model Task {
  id          String     @id @default(cuid())
  workspaceId String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueAt       DateTime?
  assigneeId  String?
  relatedType String?
  relatedId   String?
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, relatedType, relatedId])
}

model Note {
  id          String   @id @default(cuid())
  workspaceId String
  body        String
  relatedType String?
  relatedId   String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, relatedType, relatedId])
}

model Activity {
  id          String   @id @default(cuid())
  workspaceId String
  type        String
  title       String
  description String?
  relatedType String?
  relatedId   String?
  createdById String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, relatedType, relatedId])
}

model Reminder {
  id          String     @id @default(cuid())
  workspaceId String
  title       String
  remindAt    DateTime
  status      TaskStatus @default(TODO)
  relatedType String?
  relatedId   String?
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, remindAt, status])
}

model FollowUp {
  id          String     @id @default(cuid())
  workspaceId String
  title       String
  dueAt       DateTime?
  status      TaskStatus @default(TODO)
  relatedType String?
  relatedId   String?
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, dueAt])
}

model CommunicationLog {
  id          String   @id @default(cuid())
  workspaceId String
  channel     String
  direction   String?
  subject     String?
  body        String?
  relatedType String?
  relatedId   String?
  createdById String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, relatedType, relatedId])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

model Segment {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  criteria    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, name])
}

model DiagnosticSession {
  id            String           @id @default(cuid())
  workspaceId   String
  title         String
  status        DiagnosticStatus @default(DRAFT)
  relatedType   String?
  relatedId     String?
  summary       String?
  createdById   String?
  callSessionId String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  callSession  CallSession?         @relation(fields: [callSessionId], references: [id], onDelete: SetNull)
  analyses     AnalysisRecord[]
  analyzerRuns AnalyzerRun[]
  answers      DiagnosticAnswer[]
  questions    DiagnosticQuestion[]
  transcripts  Transcript[]

  @@index([workspaceId, status])
  @@index([workspaceId, relatedType, relatedId])
  @@index([callSessionId])
}

model DiagnosticQuestion {
  id          String   @id @default(cuid())
  workspaceId String
  sessionId   String
  question    String
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  session DiagnosticSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers DiagnosticAnswer[]

  @@index([workspaceId, sessionId])
}

model DiagnosticAnswer {
  id          String   @id @default(cuid())
  workspaceId String
  sessionId   String
  questionId  String?
  answer      String
  createdById String?
  createdAt   DateTime @default(now())

  question DiagnosticQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  session  DiagnosticSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sessionId])
}

model Transcript {
  id              String   @id @default(cuid())
  workspaceId     String
  sessionId       String
  content         String
  source          String?
  discoveryNotes  String?
  businessContext String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  session DiagnosticSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sessionId])
}

model AnalysisRecord {
  id             String       @id @default(cuid())
  workspaceId    String
  sessionId      String?
  title          String
  summary        String?
  executiveNotes String?
  internalNotes  String?
  observations   Json         @default("[]")
  risks          Json         @default("[]")
  status         ReviewStatus @default(DRAFT)
  createdById    String?
  reviewedById   String?
  reviewedAt     DateTime?
  finalizedById  String?
  finalizedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  session              DiagnosticSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
